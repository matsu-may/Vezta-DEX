PORT=3021
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
# Read-only Base Sepolia qualification; never use a Polygon RPC here.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Optional RPC starts/second (integer 1–6, default 3); separate from Uniswap API key quotas.
# Shared by RPC origin within one process, with at most two active requests.
BASE_SEPOLIA_RPC_RPS=3
UNISWAP_API_KEY=
# Optional only when LP API access uses a separate key; otherwise the read-only probe uses UNISWAP_API_KEY.
UNISWAP_LP_API_KEY=

# Independent Unichain Sepolia EOA adapter (server-only; optional until selected).
UNICHAIN_SEPOLIA_RPC_URL=
