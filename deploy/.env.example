# Replace example domains. Do not commit the real deploy/.env.
DEX_API_HOST=api-dex.example.com
DEX_PUBLIC_ORIGIN=https://vezta-dex-demo.vercel.app
DEX_BFF_TOKEN=
DEX_HOSTED_WRITES_ENABLED=0
